{{#partial "contenido-header"}}{{/partial}}

{{#partial "contenido"}}

    <h1>Iniciar Sesión</h1>

    {{#if exito}}
        <div class="mensaje exito">
            {{exito}}
        </div>
    {{/if}}

    <form method="POST" action="/login">
        <label>Email</label><input name="email">
        <label>Password</label><input name="password">
        <label>
            <input type="checkbox" name="recordarme" {{#if nombreRecordado}}checked{{/if}}> Recordarme
        </label>
        <button>Ingresar</button>
    </form>
    {{error}}
{{/partial}}

{{>templates/layout}}