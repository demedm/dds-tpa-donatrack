{{#partial "estilos"}}

    <link rel="stylesheet" href="/assets/css/donante.css">

{{/partial}}

{{#partial "contenido"}}

    <section class="panel-donaciones">
        <div class="panel-encabezado">
            <div>
                <h1 class="panel-titulo">Mis donaciones</h1>
                <p class="panel-subtitulo">
                    Seguí en qué estado está cada parte de lo que donaste.
                </p>
            </div>

            <a href="/donante/mapa" class="boton-mapa">
                <svg width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3z"/>
                    <path d="M9 3v15"/>
                    <path d="M15 6v15"/>
                </svg>
                Tu Mapa
            </a>
        </div>

        {{#if error}}
            <p class="aviso aviso-error" role="alert">{{error}}</p>

        {{/if}}

        {{#if hayDonaciones}}
            <!-- Filtros: un form GET -->

           <form method="GET" action="/donante/donaciones" class="filtros">

               <div class="campo">

                   <label for="estado">Estado</label>
                   <select name="estado" id="estado">

                       <option value="">Todos</option>
                       {{#each estados}}
                           <option value="{{valor}}" {{#if elegida}}selected{{/if}}>{{texto}}</option>
                       {{/each}}
                   </select>

               </div>
               <div class="campo">

                   <label for="categoria">Categoría</label>
                   <select name="categoria" id="categoria">
                       <option value="">Todas</option>
                       {{#each categorias}}
                           <option value="{{valor}}" {{#if elegida}}selected{{/if}}>{{texto}}</option>
                    {{/each}}
                    </select>
               </div>

               <div class="campo">
                   <label for="subcategoria">Subcategoría</label>
                   <select name="subcategoria" id="subcategoria">
                       <option value="">Todas</option>
                       {{#each subcategorias}}
                           <option value="{{valor}}" {{#if elegida}}selected{{/if}}>{{texto}}</option>
                       {{/each}}
                   </select>
               </div>


               <div class="filtros-acciones">
                   <button type="submit" class="boton-verde">Filtrar</button>
                   {{#if hayFiltros}}
                       <a href="/donante/donaciones" class="link-limpiar">Quitar filtros</a>
                   {{/if}}
               </div>

           </form>

            <div class="tabla-scroll">
                <table class="tabla">
                    <thead>
                    <tr>
                        <th>Donación</th>
                        <th>Recibida</th>
                        <th>Categoría</th>
                        <th>Subcategoría</th>
                        <th>Cantidad</th>
                        <th>Estado</th>
                        <th>Entidad</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each filas}}

                        <tr>
                            <td>#{{donacionId}}</td>
                            <td>{{fecha}}</td>
                            <td>{{categoria}}</td>
                            <td>{{subcategoria}}</td>
                            <td>{{cantidad}}</td>
                            <td>
                                <span class="badge {{badge}}">{{estado}}</span>
                            </td>
                            <td>{{entidad}}</td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="7" class="vacio">Ninguna donación coincide con esos filtros.
                            </td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>

        {{else}}

            {{#unless error}}

                <div class="vacio-panel">
                    <p>Todavía no tenés donaciones registradas.</p>
                    <a href="/donaciones" class="boton-verde">Hacer una donación</a>
                </div>
            {{/unless}}

        {{/if}}

    </section>


{{/partial}}


{{>templates/layout}}