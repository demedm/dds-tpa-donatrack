{{#partial "estilos"}}
    <link rel="stylesheet" href="/assets/css/beneficiarios.css">
{{/partial}}

{{#partial "contenido"}}

    <section class="panel-header">
        <div class="panel-header-inner">
            <div>
                <span class="panel-etiqueta">Panel de Entidad</span>
                <h1 class="panel-titulo">{{titulo}}</h1>
            </div>
            <a href="/usuarios/entregas-en-curso" class="btn-secundario">
                Ver envíos en recorrido →
            </a>
        </div>
    </section>

    <section class="panel-cuerpo">
        <div class="panel-contenedor">
            <div class="panel-card">
                <h2>Publicar nueva necesidad</h2>
                <form action="/necesidades" method="post" class="form-grid">
                    <div class="campo-grupo">
                        <label>Descripción:</label>
                        <input type="text" name="descripcion" placeholder="Ej: Bebidas para comedor" required>
                    </div>

                    <div class="campo-grupo">
                        <label>Tipo de necesidad:</label>
                        <select name="tipo">
                            <option value="NORMAL">Normal</option>
                            <option value="RECURRENTE">Recurrente</option>
                        </select>
                    </div>

                    <div class="campo-grupo">
                        <label>Días de recurrencia:</label>
                        <input type="number" name="diasRecurrencia" placeholder="Ej: 7">
                    </div>

                    <button type="submit" class="btn-primario">Crear necesidad</button>
                </form>
            </div>
            <div class="panel-card">
                <h2>Listado de necesidades registradas</h2>
                <div class="tabla-wrapper">
                    <table class="tabla-datos">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Detalle</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#each necesidades}}
                            <tr>
                                <td>#{{this.id}}</td>
                                <td>{{this.descripcion}}</td>
                                <td><span class="tag">{{this.estado}}</span></td>
                                <td>
                                    <a class="link-accion" href="/necesidades/{{this.id}}">Ver detalle</a>
                                </td>
                            </tr>
                        {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
{{/partial}}

{{>templates/layout}}