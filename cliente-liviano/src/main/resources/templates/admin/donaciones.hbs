{{#partial "estilos"}}
    <link rel="stylesheet" href="/assets/css/admin/admin.css">
    <link rel="stylesheet" href="/assets/css/admin/admin-donaciones.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="admin">
        <h1 class="sr-only">Panel de administración: Donaciones</h1>

        <!-- Pestañas del panel -->
        <nav class="admin-tabs" aria-label="Secciones de administración">
            <a href="/admin/donaciones" aria-current="page">Donaciones</a>
            <a href="/admin/usuarios">Usuarios</a>
            <a href="/admin/logistica">Logística</a>
        </nav>

        {{#if error}}
            <p class="aviso aviso-error" role="alert">{{error}}</p>

        {{/if}}
        {{#if asignada}}
            <p class="aviso aviso-ok" role="status"> La donación #{{asignada}} se asigno correctamente.</p>

        {{/if}}
        {{#if errorAsignacion}}
            <p class= "aviso aviso-error" role="alert"> No se pudo realizar la asignación. Probá de nuevo.</p>
        {{/if}}

        {{#if vencidas}}
            <p class="aviso aviso-ok" role="status">Se marcaron {{vencidas}} donaciones como vencidas.</p>
        {{/if}}
        {{#if noVencidas}}
            <p class="aviso aviso-error" role="alert">
                No se pudieron marcar {{noVencidas}} donaciones como vencidas (solo se pueden vencer las que están en depósito).
            </p>
        {{/if}}
        {{#if errorSinSeleccion}}
            <p class="aviso aviso-error" role="alert">Seleccioná al menos una donación para marcarla como vencida.</p>
        {{/if}}

        <!-- Barra de búsqueda y acción principal -->
        <div class="admin-barra">
            <form action="/admin/donaciones" method="GET" class="busqueda" role="search">
                <div class="campo campo-compacto">
                    <label class="sr-only" for="buscar">Buscar</label>
                    <input type="search" id="buscar" name="q" placeholder="Search">
                </div>
                <div class="campo campo-compacto">
                    <label class="sr-only" for="categoria">Categoría</label>
                    <select id="categoria" name="categoria">
                        <option value="">Category</option>
                        <option value="estado">Estado</option>
                        <option value="entidad">Entidad</option>
                        <option value="donante">Donante</option>
                    </select>
                </div>
                <button type="submit" class="boton-icono boton-buscar" aria-label="Buscar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </button>
                <button type="button" class="boton-icono boton-filtros" aria-label="Filtros">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>
                </button>
            </form>

            <a href="/admin/donaciones/nueva" class="boton-rojo">
                Registrar
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
        </div>

        <!-- ===== ASIGNACIÓN ===== -->
        <div class="asignacion">


            <!-- Lista de donaciones a asignar -->
            <section class="tarjeta asignacion-lista">
                <div class="tabla-scroll">
                    <table class="tabla">
                        <thead>
                        <tr>
                            <th>Donación</th>
                            <th>Vcto.</th>
                            <th><span class="sr-only">Depósito</span></th>
                            <th><span class="sr-only">Asignar</span></th>
                        </tr>
                        </thead>
                        <tbody>

                        {{#each donacionesPendientes}}
                        <tr>
                            <td>{{descripcion}}</td>
                            <td>{{vencimiento}}</td>
                            <td><a href="#" class="boton-deposito">Depósito</a></td>
                            <td>
                                <a href="/admin/donaciones?seleccionada={{id}}" class="boton-icono boton-flecha" aria-label="Ver asignacion de {{descripcion}}">

                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 4l-1.4 1.4L16.2 11H4v2h12.2l-5.6 5.6L12 20l8-8z"/></svg>
                                </a>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="4" class="vacio"> No hay donaciones en deposito</td>
                        </tr>
                        {{/each}}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Resultados de asignación -->
            <section class="resultados">
                <div class="resultados-cabecera">
                    <h2 class="resultados-titulo">Resultados de Asignación</h2>

                    <div class="pestanas" role="tablist" aria-label="Resultados de asignación">
                        <button type="button" role="tab" class="pestana" id="tab-resumen" aria-controls="panel-resumen" aria-selected="true">Resumen</button>
                        {{#each algoritmos}}
                            <button type="button" role="tab" class="pestana" id="tab-alg-{{@index}}" aria-controls="{{panel}}" aria-selected="false" tabindex="-1">{{nombre}}</button>
                        {{/each}}
                    </div>
                </div>

                <!-- Resumen -->
                <div class="panel-resultado" role="tabpanel" id="panel-resumen" aria-labelledby="tab-resumen">
                    {{#if seleccion}}

                    <h3 class="seleccion-titulo">Donación Seleccionada</h3>

                    <div class="seleccion-datos">
                        <span><strong>Categoría:</strong> {{seleccion.categoria}}</span>
                        <span><strong>Subcategoría:</strong> {{seleccion.bien}}</span>
                        <span><strong>Cantidad:</strong> {{seleccion.cantidad}}</span>
                        <span><strong>Uso:</strong> {{seleccion.uso}}</span>
                        <span><strong>Vencimiento:</strong> {{seleccion.vencimiento}}</span>
                        <span><strong>Foto:</strong> <a href="#" target="_blank" rel="noopener">link</a></span>
                    </div>

                    <div class="caja-resultados">
                        {{#if resultados}}
                            {{#unless huboCoincidencias}}
                                <p class="vacio"> Ningun algoritmo coincidio: se muestran todas las entidades propuestas</p>
                            {{/unless}}
                        <div class="tabla-scroll">
                            <table class="tabla">
                                <thead>
                                <tr>
                                    <th class="col-check">#</th>
                                    <th>Entidad</th>
                                    <th>Tipo</th>
                                    <th>Direccion</th>
                                    <th><span class="sr-only"> Asignar</span></th>
                                </tr>
                                </thead>
                                <tbody>
                                {{!-- Reemplazar por {{#each resultados}} --}}
                                {{#each resultados}}

                                <tr>
                                    <td>{{posicion}}.</td>
                                    <td>{{razonSocial}}</td>
                                    <td>{{tipo}}</td>
                                    <td>{{direccion}}</td>
                                    <td>
                                        <form action="/admin/donaciones/{{../seleccion.id}}/asignacion" method="post">
                                            <input type="hidden" value="{{id}}" name="entidadId">
                                            <button type="submit" class="enlace-accion">Asignar</button>
                                        </form>
                                    </td>
                                </tr>
                                {{/each}}
                                </tbody>
                            </table>
                        </div>
                            {{else}}
                                <p class="vacio">Todavia no se ejecuto el matchmaking para esta donacion</p>
                            {{/if}}
                    </div>
                        {{else}}
                        <div class="caja-resultados">
                            <p class="vacio"> Elegi una donación de la lista con la flecha para ver las entidades propuestas</p>
                        </div>
                        {{/if}}
                </div>


                <!-- Algoritmo de compatibilidad -->
                {{#each algoritmos}}
                    <div class="panel-resultado" role="tabpanel" id="{{panel}}" aria-labelledby="tab-alg-{{@index}}" hidden>
                        <div class="caja-resultados">
                        {{#if entidades}}
                        <div class="tabla-scroll">
                            <table class="tabla">
                                <thead>
                                <tr>
                                    <th class="col-check">#</th>
                                    <th>Entidad</th>
                                    <th>Tipo</th>
                                    <th>Direccion</th>
                                </tr>
                                </thead>
                                <tbody>
                                {{#each entidades}}
                                    <tr>
                                        <td>{{posicion}}.</td>
                                        <td>{{razonSocial}}</td>
                                        <td>{{tipo}}</td>
                                        <td>{{direccion}}</td>
                                    </tr>
                                {{/each}}
                                </tbody>
                            </table>
                        </div>
                        {{else}}
                        <p class="vacio"> Este algoritmo no encontró entidades.</p>
                        {{/if}}
                        </div>
                    </div>
                {{/each}}
            </section>
        </div>

        <!-- ===== ACCIONES SOBRE LAS DONACIONES ===== -->
        <form id="form-vencer" method="post" action="/admin/donaciones/vencidas"></form>
        <div class="acciones-tabla">
            <label class="check-recordame check-tabla">
                <input type="checkbox" id="seleccionarTodas">
                <span class="check-caja"></span>
                <span class="check-texto">Seleccionar Donaciones</span>
            </label>

            <div class="acciones-tabla-der">
                <button type="button" class="enlace-accion">Mostrar Detalles</button>
                <button type="button" class="enlace-accion">Reactivar</button>

                <button type="submit" class="enlace-accion" form="form-vencer">Marcar como Vencida</button>

                <button type="button" class="enlace-accion">Eliminar</button>

                <div class="campo campo-compacto">
                    <label class="sr-only" for="modificar">Modificar</label>
                    <select id="modificar">
                        <option value="" disabled selected>Modificar</option>
                        <option value="datos">Datos de la donación</option>
                        <option value="estado">Estado</option>
                    </select>
                </div>
                <div class="campo campo-compacto">
                    <label class="sr-only" for="asignar">Asignar</label>
                    <select id="asignar">
                        <option value="" disabled selected>Asignar</option>
                        <option value="entidad">Entidad</option>
                        <option value="deposito">Depósito</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- ===== TABLA DE DONACIONES ===== -->
        <section class="tarjeta tarjeta-tabla tabla-donaciones">
            <div class="tabla-scroll">
                <table class="tabla">
                    <thead>
                    <tr>
                        <th class="col-check"><span class="sr-only">Seleccionar</span></th>
                        <th>Descripción</th>
                        <th>Bienes</th>
                        <th>Entidad</th>
                        <th>Donante</th>
                        <th>Estado</th>
                    </tr>
                    </thead>

                    <tbody>
                    {{#each donaciones}}
                    <tr>
                        <td>
                            <label class="check-recordame check-tabla">

                                <input type="checkbox" name="donaciones" value="{{id}}" form="form-vencer" {{#unless vencible}}disabled{{/unless}}>

                                <span class="check-caja"></span>

                                <span class="sr-only">Seleccionar donación {{id}}</span>

                            </label>
                        </td>

                        <td>{{descripcion}}</td>
                        <td>{{bien}} ({{cantidad}})</td>
                        <td>{{entidad}}</td>
                        <td>{{donante}}</td>
                        <td><span class="badge {{badge}}">{{estado}}</span></td>
                    </tr>
                    {{else}}
                        <tr><td class="vacio" colspan="6">No hay donaciones cargadas.</td></tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <script>
        // ----- Pestañas de resultados -----
        const pestanas = [...document.querySelectorAll('.pestana')];
        const paneles = document.querySelectorAll('.panel-resultado');

        function activarPestana(tab) {
            pestanas.forEach(t => {
                const activa = t === tab;
                t.setAttribute('aria-selected', activa);
                t.tabIndex = activa ? 0 : -1;
            });
            paneles.forEach(p => {
                p.hidden = p.id !== tab.getAttribute('aria-controls');
            });
        }

        pestanas.forEach((tab, i) => {
            tab.addEventListener('click', () => activarPestana(tab));
            tab.addEventListener('keydown', e => {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                const siguiente = pestanas[(i + (e.key === 'ArrowRight' ? 1 : -1) + pestanas.length) % pestanas.length];
                activarPestana(siguiente);
                siguiente.focus();
            });
        });

        // ----- Seleccionar todas las donaciones -----
        const todas = document.getElementById('seleccionarTodas');
        const filas = document.querySelectorAll('input[name="donaciones"]');

        todas.addEventListener('change', () => {
            filas.forEach(f => f.checked = todas.checked);
        });
        filas.forEach(f => f.addEventListener('change', () => {
            todas.checked = [...filas].every(x => x.checked);
        }));
    </script>
{{/partial}}

{{>templates/layout}}