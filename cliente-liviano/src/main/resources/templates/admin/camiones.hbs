
{{#partial "contenido-header"}}{{/partial}}

{{#partial "contenido"}}
    <link rel="stylesheet" href="/assets/css/vista-camiones.css">

    <section class="camiones">
        <div class="encabezado-seccion">
            <div>
                <h1>Gestión de camiones</h1>
                <p>Consultá y administrá los camiones registrados en el sistema.</p>
            </div>

            <button>
                <a href="/camiones/nuevo" class="boton">
                    Registrar camión
                </a>
            </button>
        </div>

        {{#if camiones}}
            <div class="tabla-container">
                <table class="tabla-camiones">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patente</th>
                        <th>Capacidad de carga</th>
                        <th>Capacidad de volumen</th>
                        <th>Altura</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                    </thead>

                    <tbody>
                    {{#each camiones}}
                        <tr>
                            <td>{{id}}</td>
                            <td class="patente">{{patente}}</td>
                            <td>{{capacidadCarga}} kg</td>
                            <td>{{capacidadVolumen}} m³</td>
                            <td>{{altura}} m</td>
                            <td>
                                <span class="estado-camion">
                                    {{estado}}
                                </span>
                            </td>
                            <td>
                                <a href="/" class="boton boton-modificar">
                                    Modificar
                                </a>
                            </td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
        {{else}}
            <div class="mensaje-info">
                <h3>No hay camiones registrados</h3>
                <p>Cuando registres un camión, aparecerá en este listado.</p>
                <a href="/camiones/nuevo" class="boton">
                    Registrar primer camión
                </a>
            </div>
        {{/if}}
    </section>
{{/partial}}

{{>templates/layout}}
