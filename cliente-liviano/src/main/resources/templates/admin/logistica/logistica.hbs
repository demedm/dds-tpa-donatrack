{{#partial "estilos"}}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="/assets/css/admin/admin.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="admin">
        <h1 class="sr-only">Panel de administración: Logística</h1>

        <!-- Pestañas -->
        <nav class="admin-tabs" aria-label="Secciones de administración">
            <a href="/admin/donaciones">Donaciones</a>
            <a href="/admin/usuarios">Usuarios</a>
            <a href="/admin/logistica" aria-current="page">Logística</a>
        </nav>

        <!-- Barra de búsqueda y acciones -->
        <div class="admin-barra">
            <form action="/admin/logistica" method="GET" class="busqueda" role="search">
                <div class="campo campo-compacto">
                    <label class="sr-only" for="buscar">Buscar</label>
                    <input type="search" id="buscar" name="q" placeholder="Search">
                </div>
                <div class="campo campo-compacto">
                    <label class="sr-only" for="categoria">Categoría</label>
                    <select id="categoria" name="categoria">
                        <option value="">Category</option>
                        <option value="camiones">Camiones</option>
                        <option value="rutas">Rutas</option>
                        <option value="choferes">Choferes</option>
                    </select>
                </div>
                <button type="submit" class="boton-icono boton-buscar" aria-label="Buscar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </button>
                <button type="button" class="boton-icono boton-filtros" aria-label="Filtros">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>
                </button>
            </form>

            <div class="admin-agregar">

                <button type="button" id="agregarRuta" class="enlace-accion" disabled>
                    Planificar Seleccionados
                </button>
                <a href="/admin/camiones/nuevo" class="boton-rojo">
                    Agregar Camión
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </a>
            </div>
        </div>
        {{#if error}}<p class="aviso-error" role="alert">{{error}}</p>{{/if}}
        <div class="admin-grilla">

            <!-- ===== COLUMNA IZQUIERDA ===== -->
            <div class="admin-col" id="colIzquierda">
                <section class="tarjeta" id="panelVacio">
                    <h2>Panel de logística</h2>
                    <p>Seleccioná un camión y presioná "Mostrar Detalles" para consultar su información.</p>
                </section>
            </div>
            <!-- ===== COLUMNA DERECHA ===== -->
            <div class="admin-col">

                <!-- Mapa  -->
                <div class="mapa" id="mapa" role="region" aria-label="Mapa de entregas en curso"
                     data-url="/admin/logistica/entregas-en-curso">
                    <!-- xd -->
                </div>

                <!-- Acciones sobre el camión seleccionado -->
                <div class="acciones-tabla">
                    <label class="check-recordame check-tabla">
                        <input type="checkbox" id="seleccionarTodos">
                        <span class="check-caja"></span>
                        <span class="check-texto">Seleccionar Camión</span>
                    </label>

                    <div class="acciones-tabla-der">
                        <button
                                type="button"
                                id="mostrarDetalles"
                                class="enlace-accion"
                                disabled>
                            Mostrar Detalles
                        </button>
                        <button type="button" class="enlace-accion">Reactivar</button>
                        <button type="button" class="enlace-accion">Eliminar</button>

                        <div class="campo campo-compacto">
                            <label class="sr-only" for="modificar">Modificar</label>
                            <select id="modificar">
                                <option value="" disabled selected>Modificar</option>
                                <option value="datos">Datos del camión</option>
                                <option value="estado">Estado</option>
                            </select>
                        </div>
                        <div class="campo campo-compacto">
                            <label class="sr-only" for="asignar">Asignar</label>
                            <select id="asignar">
                                <option value="" disabled selected>Asignar</option>
                                <option value="chofer">Chofer</option>
                                <option value="ruta">Ruta</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Tabla de camiones -->
                <section class="tarjeta tarjeta-tabla">
                    <div class="tabla-scroll">
                        <table class="tabla">
                            <thead>
                            <tr>
                                <th class="col-check">#</th>
                                <th>Patente</th>
                                <th>Chofer</th>
                                <th>Características</th>
                                <th>Estado</th>
                            </tr>
                            </thead>
                            <tbody>
                                {{#each camiones}}
                                    <tr>
                                        <td>
                                            <label class="check-recordame check-tabla">
                                                <input
                                                        type="checkbox"
                                                        name="camionesSeleccionados"
                                                        value="{{id}}"
                                                        class="checkbox-camion"
                                                >
                                                <span class="check-caja"></span>
                                                <span class="sr-only">Seleccionar camión {{patente}}</span>
                                            </label>
                                        </td>
                                        <td>{{patente}}</td>
                                        <td>{{chofer}}</td>
                                        <td>{{caracteristicas}}</td>
                                        <td><span class="badge {{claseEstado}}">{{estadoTxt}}</span></td>
                                    </tr>
                                {{else}}
                                    <tr><td colspan="5">No hay camiones registrados.</td></tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

        </div>
    </div>

    <script>
        (function () {
            const checkboxes = document.querySelectorAll('.checkbox-camion');

            const seleccionarTodos = document.getElementById('seleccionarTodos');
            const botonDetalles = document.getElementById('mostrarDetalles');
            const botonAgregarRuta = document.getElementById('agregarRuta');
            const col = document.getElementById('colIzquierda');

            // Obtener los IDs de todos los camiones seleccionados.
            function obtenerCamionesSeleccionados() {
                return Array.from(checkboxes)
                        .filter(checkbox => checkbox.checked)
                        .map(checkbox => Number(checkbox.value));
            }

            // Actualizar el estado de los botones y del checkbox general.
            function actualizarBotones() {
                const seleccionados = obtenerCamionesSeleccionados();
                const cantidad = seleccionados.length;

                // Mostrar detalles solamente permite un camión.
                botonDetalles.disabled = cantidad !== 1;

                // Agregar ruta permite uno o varios camiones.
                botonAgregarRuta.disabled = cantidad === 0;

                // Actualizar selección general.
                seleccionarTodos.checked =
                        checkboxes.length > 0 && cantidad === checkboxes.length;

                seleccionarTodos.indeterminate =
                        cantidad > 0 && cantidad < checkboxes.length;
            }

            // Escuchar cambios individuales.
            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', actualizarBotones);
            });

            // Seleccionar o deseleccionar todos los camiones.
            seleccionarTodos.addEventListener('change', function () {
                checkboxes.forEach(checkbox => {
                    checkbox.checked = seleccionarTodos.checked;
                });

                actualizarBotones();
            });

            // Mostrar detalles de un único camión.
            botonDetalles.addEventListener('click', async function () {
                const seleccionados = obtenerCamionesSeleccionados();

                if (seleccionados.length !== 1) return;

                const camionId = seleccionados[0];

                try {
                    const response = await fetch(
                            '/admin/logistica/camion/' +
                            encodeURIComponent(camionId) +
                            '/panel'
                    );

                    if (!response.ok) {
                        throw new Error('No se pudo cargar el camión');
                    }

                    col.innerHTML = await response.text();

                } catch (error) {
                    console.error(error);
                    alert('No se pudieron cargar los detalles del camión.');
                }
            });

            // Iniciar planificación manual con los camiones seleccionados.
            botonAgregarRuta.addEventListener('click', async function () {
                const camiones = obtenerCamionesSeleccionados();

                if (camiones.length === 0) return;

                botonAgregarRuta.disabled = true;

                try {
                    const response = await fetch(
                            '/admin/logistica/planificar',
                            {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Accept': 'application/json'
                                },
                                body: JSON.stringify({
                                    camionesIds: camiones
                                })
                            }
                    );

                    const resultado = await response.json();

                    if (!response.ok || resultado.exito === false) {
                        throw new Error(
                                resultado.mensaje ||
                                'No se pudo iniciar la planificación'
                        );
                    }

                    alert(
                            resultado.mensaje ||
                            'La planificación se inició correctamente.'
                    );

                } catch (error) {
                    console.error(error);
                    alert(error.message || 'Error al iniciar la planificación.');

                } finally {
                    actualizarBotones();
                }
            });

            // Estado inicial.
            actualizarBotones();

        })();
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/assets/js/logistica-mapa.js"></script>
{{/partial}}

{{>templates/layout}}