
{{#partial "estilos"}}
    <link rel="stylesheet" href="/assets/css/auth.css">
    <link rel="stylesheet" href="/assets/css/donacion.css">
    <link rel="stylesheet" href="/assets/css/donacion-detalle.css">
{{/partial}}

{{#partial "contenido"}}
    <div class="detalle-donacion">
        <section class="detalle-panel">

            <h1 class="detalle-titulo">Registrar un nuevo camión</h1>

            <p class="detalle-descripcion">
                Completá los datos del vehículo para incorporarlo a la flota logística.
            </p>

            {{#if error}}
                <div class="mensaje error" role="alert">
                    {{error}}
                </div>
            {{/if}}

            {{#if exito}}
                <div class="mensaje exito" role="status">
                    {{exito}}
                </div>
            {{/if}}

            <form action="/admin/camiones/nuevo" method="POST" class="form-detalle">

                <fieldset class="articulo">
                    <h2 class="articulo-titulo">Datos del camión</h2>

                    <div class="campo">
                        <label for="patente">Patente *</label>
                        <input
                                type="text"
                                id="patente"
                                name="patente"
                                placeholder="Ej: AB123CD"
                                maxlength="10"
                                required
                        >
                    </div>

                    <div class="campo">
                        <label for="capacidadCarga">Capacidad de carga (kg) *</label>
                        <input
                                type="number"
                                id="capacidadCarga"
                                name="capacidadCarga"
                                min="0.01"
                                step="0.01"
                                placeholder="Ej: 5000"
                                required
                        >
                    </div>

                    <div class="campo">
                        <label for="capacidadVolumen">Capacidad de volumen (m³) *</label>
                        <input
                                type="number"
                                id="capacidadVolumen"
                                name="capacidadVolumen"
                                min="0.01"
                                step="0.01"
                                placeholder="Ej: 25.5"
                                required
                        >
                    </div>

                    <div class="campo">
                        <label for="altura">Altura (m) *</label>
                        <input
                                type="number"
                                id="altura"
                                name="altura"
                                min="0.01"
                                step="0.01"
                                placeholder="Ej: 3.5"
                                required
                        >
                    </div>
                </fieldset>

                <div class="acciones-formulario">
                    <a href="/admin/camiones" class="boton-cancelar">
                        Cancelar
                    </a>

                    <button type="submit" class="boton-auth boton-donar-final">
                        Registrar camión
                    </button>
                </div>

            </form>
        </section>
    </div>
{{/partial}}

{{>templates/layout}}