{{#partial "contenido-header"}}{{/partial}}

{{#partial "contenido"}}

    <h1>Registrar un nuevo camión</h1>

    {{#if error}}
        <div class="mensaje error">
            {{error}}
        </div>
    {{/if}}

    {{#if exito}}
        <div class="mensaje exito">
            {{exito}}
        </div>
    {{/if}}

    <form action="/admin/camiones" method="POST">

        <h3>Datos del camión</h3>

        <label for="patente">Patente</label>
        <input
                type="text"
                id="patente"
                name="patente"
                placeholder="Ej: AB123CD"
                maxlength="10"
                required
        >

        <label for="capacidadCarga">Capacidad de carga (kg)</label>
        <input
                type="number"
                id="capacidadCarga"
                name="capacidadCarga"
                min="0.01"
                step="0.01"
                placeholder="Ej: 5000"
                required
        >

        <label for="capacidadVolumen">Capacidad de volumen (m³)</label>
        <input
                type="number"
                id="capacidadVolumen"
                name="capacidadVolumen"
                min="0.01"
                step="0.01"
                placeholder="Ej: 25.5"
                required
        >

        <label for="altura">Altura (m)</label>
        <input
                type="number"
                id="altura"
                name="altura"
                min="0.01"
                step="0.01"
                placeholder="Ej: 3.5"
                required
        >

        <label for="estado">Estado del camión</label>
        <select id="estado" name="estado" required>
            <option value="" disabled selected>— Elegir estado —</option>
            <option value="DISPONIBLE">Disponible</option>
            <option value="EN_MANTENIMIENTO">En mantenimiento</option>
            <option value="FUERA_DE_SERVICIO">Fuera de servicio</option>
        </select>

        <button type="submit">Registrar camión</button>

        <a href="/admin/camiones">Cancelar</a>

    </form>

{{/partial}}

{{>templates/layout}}