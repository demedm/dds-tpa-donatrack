<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Necesidad - {{necesidad.descripcion}}</title>
    <link rel="stylesheet" href="/css/estilo-minimal.css">
</head>
<body>
<div class="container">
    <a class="link-volver" href="/necesidades">&larr; Volver a mis necesidades</a>

    <h1>{{necesidad.descripcion}}</h1>

    <div class="detalle-necesidad">
        <span class="tag">{{necesidad.tipo}}</span>
        {{#if necesidad.esRecurrente}}
            <span class="badge badge-info">Proximo vencimiento el {{necesidad.proximoVencimiento}}</span>
            {{#if necesidad.estaVencida}}
                <span class="badge badge-pending">Vencida</span>
            {{else}}
                <span class="badge badge-done">Activa</span>
            {{/if}}
        {{/if}}
    </div>

    <h2>Agregar Peticion</h2>
    <form action="/necesidades/{{necesidad.id}}/peticiones" method="POST">
        <label>Subclase / Item:</label>
        <input type="text" name="subclase" placeholder="Ej: ARROZ, FIDEOS" required>

        <label>Cantidad Requerida:</label>
        <input type="number" name="cantidadRequerida" min="1" required>

        <button type="submit">Agregar Petición</button>
    </form>

    <section class="detalle-seccion">
        <h2>Peticiones de la necesidad</h2>
        <table class="peticiones-table">
            <thead>
            <tr>
                <th>ID</th>
                <th>Pedido</th>
                <th>Cantidad solicitada</th>
                <th>Cantidad recibida</th>
                <th>Cubierta</th>
            </tr>
            </thead>
            <tbody>
            {{#each necesidad.peticiones}}
                <tr>
                    <td>{{this.id}}</td>
                    <td>{{this.subclase}}</td>
                    <td>{{this.cantidadRequerida}}</td>
                    <td>{{this.cantidadRecibida}}</td>
                    <td>
                        <!-- Usamos el getter estaCubierta de la clase Peticion -->
                        {{#if this.estaCubierta}}
                            <span class="badge badge-done">Sí</span>
                        {{else}}
                            <span class="badge badge-pending">No</span>
                        {{/if}}
                    </td>
                </tr>
            {{/each}}
            </tbody>
        </table>
    </section>

    <h2>Completar y Adjuntar Comprobante/Foto</h2>
    <form action="/necesidades/{{necesidad.id}}/adjuntos" method="POST" enctype="multipart/form-data">
        <label>Seleccionar Imagen:</label>
        <input type="file" name="foto" accept="image/*" required>

        <button type="submit">Subir Foto</button>
    </form>

    {{#if necesidad.tieneAdjuntos}}
        <h3>Fotos adjuntas:</h3>
        <div class="galeria-adjuntos">
            {{#each necesidad.adjuntos}}
                <img src="{{this}}" alt="Adjunto" width="200">
            {{/each}}
        </div>
    {{/if}}
</div>
</body>
</html>