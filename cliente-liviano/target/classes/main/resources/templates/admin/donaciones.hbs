{{#partial "contenido"}}
    <div class="admin">
        <h1 class="sr-only">Panel de administración: Donaciones</h1>

        <!-- Pestañas del panel -->
        <nav class="admin-tabs" aria-label="Secciones de administración">
            <a href="/admin/donaciones" aria-current="page">Donaciones</a>
            <a href="/admin/usuarios">Usuarios</a>
            <a href="/admin/logistica">Logística</a>
        </nav>

        <!-- Barra de búsqueda y acción principal -->
        <div class="admin-barra">
            <form action="/admin/donaciones" method="GET" class="busqueda" role="search">
