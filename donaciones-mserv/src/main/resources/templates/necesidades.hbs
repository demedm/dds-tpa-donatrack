<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Tareas</title>
    <link rel="stylesheet" href="/css/estilo-minimal.css">
</head>
<body>
<div class="container">
    <h1>{{titulo}}</h1>
    <a href="http://localhost:9002/usuarios/1/entregas-en-curso" class="btn btn-info">
        Ver envíos en recorrido
    </a>
    <form action="/necesidades" method="post" class="nueva-necesidad-post">
        <label>Entidad ID (por ahora MOCK):</label>
        <input type="text" name="entidadId" value="001" required>

        <label>Descripcion: </label>
        <input type="text" name="descripcion" placeholder="Ej:Bebidas para comedor">

        <label>Tipo de necesidad: </label>
        <select name="tipo">
            <option value="NORMAL">Normal</option>
            <option value="RECURRENTE">Recurrente</option>
        </select>

        <label>Dias de recurrencia: </label>
        <input type="number" name="diasRecurrencia" placeholder="Ej: 7">

        <button type="submit">Crear necesidad y agregar peticiones</button>
    </form>

    <table class="necesidades-table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Detalle</th>
        </tr>
        </thead>
        <tbody>
        {{#each necesidades}}
            <tr>
                <td>{{this.id}}</td>
                <td>{{this.descripcion}}</td>
                <td><span class="tag">{{this.estado}}</span></td>
                <td class="detalle">
                    <a class="link-detalle" href="/necesidades/{{this.id}}">Ver</a>
                </td>
            </tr>
        {{/each}}
        </tbody>
    </table>
</div>
</body>
</html>